generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String   @db.VarChar(2000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  games       Game[]
}

model Game {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title       String   @db.VarChar(200)
  description String   @db.VarChar(10000)
  platform    String   @db.VarChar(100)
  imageUrl    String?  @db.VarChar(2048)
  igdbId      Int?     @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reviews     Review[]

  @@index([categoryId, createdAt, id])
  @@index([createdAt, id])
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique @db.VarChar(254)
  displayName     String           @db.VarChar(100)
  passwordHash    String
  role            Role             @default(USER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  reviews         Review[]
  refreshSessions RefreshSession[]
}

model RefreshSession {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  Int       @default(autoincrement())
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
}

model Review {
  id        Int      @id @default(autoincrement())
  gameId    Int
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Restrict)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  text      String   @db.VarChar(5000)
  rating    Int      @db.SmallInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, authorId])
  @@index([gameId, createdAt, id])
}
