{
  "name": "@gameon/api",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsc-watch --project tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "seed": "node dist/seed/main.js",
    "test": "rm -rf dist/test && tsc --outDir dist/test --rootDir . && node --test dist/test/test/*.test.js",
    "test:integration": "rm -rf dist/test && tsc --outDir dist/test --rootDir . && node --test dist/test/test/integration/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.19.0",
    "prisma": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie": "^1.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "tsc-watch": "^7.2.0",
    "typescript": "^6.0.3"
  }
}
