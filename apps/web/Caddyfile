{$SITE_ADDRESS::80} {
	root * /srv
	encode zstd gzip

	@api path_regexp ^/api/
	handle @api {
		reverse_proxy api:3000
	}

	@assets path_regexp ^/assets/
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}

:9090 {
	respond /healthz "OK" 200
}
